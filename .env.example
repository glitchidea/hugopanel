# ============================================================
# HugoPanel — Environment Variables
# Kopyala: cp .env.example .env
# ============================================================

# ─── Django ─────────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=hugopanel.settings.production

# ─── Database ───────────────────────────────────────────────
POSTGRES_DB=hugopanel
POSTGRES_USER=hugopanel
POSTGRES_PASSWORD=hugopanel_secret
DATABASE_URL=postgresql://hugopanel:hugopanel_secret@db:5432/hugopanel

# ─── Redis / Celery ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Token Encryption (Fernet key) ──────────────────────────
# Yeni key üretmek için: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# ─── Git Identity (sunucu varsayılanı — kullanıcı Ayarlar'dan da belirleyebilir) ─
GIT_AUTHOR_NAME=HugoPanel
GIT_AUTHOR_EMAIL=hugopanel@noreply.com

# ─── CORS ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3003

# ─── Frontend ───────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=HugoPanel
